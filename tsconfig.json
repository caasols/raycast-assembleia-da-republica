{
  "$schema": "https://json.schemastore.org/tsconfig",
  // scripts/ is included so `npm run typecheck` covers smoke.ts too — tsx
  // executes it untyped, so nothing else would ever typecheck it.
  "include": ["src/**/*", "scripts/**/*", "raycast-env.d.ts"],
  // Tests are checked separately by tsconfig.test.json: they need the DOM lib,
  // which the extension itself must not have, since it does not run in a browser.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "compilerOptions": {
    "lib": ["ES2023"],
    // Declared explicitly rather than arriving transitively via the test
    // files' vitest import, which the exclude above now cuts off.
    "types": ["node", "react"],
    "module": "commonjs",
    "target": "ES2023",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true
  }
}
