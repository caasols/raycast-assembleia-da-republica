# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# secrets: the openAR API needs no auth today, but never let an env file reach the repo
.env
.env.*
!.env.example

# dependencies
/node_modules

# Raycast specific files
raycast-env.d.ts
.raycast-swift-build
.swiftpm
compiled_raycast_swift
compiled_raycast_rust

# test output
coverage/

# internal working docs: kept on disk, never published to the public repo
docs/*
!docs/openar-openapi.json
PROJECT_BRIEF.md

# CLAUDE.md and context.md are deliberately TRACKED (see context.md D14): they are
# the agent working agreement and the decision log, and both are worthless if
# they die with an ephemeral dev container. They contain no secrets.

# build output
dist/
build/
*.tsbuildinfo

# logs
*.log
npm-debug.log*
yarn-error.log*

# editor
.vscode/
.idea/

# misc
.DS_Store
