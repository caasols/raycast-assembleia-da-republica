# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# secrets: the openAR API needs no auth today, but never let an env file reach the repo
.env
.env.*
!.env.example

# dependencies
/node_modules

# Raycast specific files
raycast-env.d.ts
.raycast-swift-build
.swiftpm
compiled_raycast_swift
compiled_raycast_rust

# test output
coverage/
# mutation testing (Stryker) work dirs - the config file IS tracked
.stryker-tmp/
reports/
stryker.log

# The agent working agreement and the decision log: local-only, never published.
# D109 reversed D14 and returned both to this file. They stay on disk with their
# full content; git simply stops tracking them. Note that this does NOT remove
# them from history: both are still present in every commit up to `ba8139e`.
CLAUDE.md
context.md

# internal working docs and agent scratch: kept on disk, never published.
# docs/ is where superpowers skills, brainstorms, plans and research notes land,
# so the whole directory is ignored and the vendored spec is negated back in as
# the single deliberate exception (see context.md D18).
docs/*
!docs/openar-openapi.json
PROJECT_BRIEF.md

# agent tooling scratch
.superpowers/
.claude/scratch/
graphify-out/

# build output
dist/
build/
*.tsbuildinfo

# logs
*.log
npm-debug.log*
yarn-error.log*

# editor
.vscode/
.idea/

# misc
.DS_Store

# python helpers (graphify and friends)
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
